# UI テスト用コンテナ
# 通常の app Dockerfile をベースに Playwright + Chromium を追加する。
# Chromium のシステム依存が大きいため、本番 Dockerfile とは分けている。
FROM python:3.11-slim

WORKDIR /app

# アプリ依存 + テスト依存
COPY requirements.txt requirements-dev.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-dev.txt

# 最新の Playwright 同梱 node は libatomic を要求する（slim イメージには無い）
RUN apt-get update && apt-get install -y --no-install-recommends libatomic1 && rm -rf /var/lib/apt/lists/*

# Playwright + pytest-playwright のインストール
RUN pip install pytest-playwright playwright

# Chromium とそのシステム依存をインストール（--with-deps で apt 依存も解決）
RUN playwright install chromium --with-deps

COPY . .
